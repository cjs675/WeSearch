# WeSearch needs no API keys or accounts. Everything below is optional.

# Optional AI pass for resume analysis. Leave RESUME_AI_PROVIDER unset to use the
# built-in rule-based analysis, which always works without any setup.
# With a remote provider, resume text is sent to that service.

# Local Gemma through Ollama (run `ollama pull gemma3:4b` first):
# RESUME_AI_PROVIDER=ollama
# RESUME_AI_MODEL=gemma3:4b
# RESUME_AI_BASE_URL=http://localhost:11434/v1

# Any other OpenAI-compatible chat endpoint:
# RESUME_AI_PROVIDER=openai-compatible
# RESUME_AI_BASE_URL=https://example.com/v1
# RESUME_AI_MODEL=model-name
# RESUME_AI_API_KEY=...

# How long to wait for the AI before falling back to rules (milliseconds).
# RESUME_AI_TIMEOUT_MS=20000
