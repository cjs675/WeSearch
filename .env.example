# Copy this file to .env.local and fill in your own values. .env.local stays out of git.
# Never prefix these with NEXT_PUBLIC_, which would expose them to the browser.

# Job listings (feature/job-matching). Free key: https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional, adds government listings. Free key: https://developer.usajobs.gov/apirequest/
USAJOBS_EMAIL=
USAJOBS_API_KEY=

# AI resume analysis (feature/resume-analysis). Add the key your chosen provider needs here.
